rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }
    match /classes/{classId} {
      allow read, write: if true;
    }
    match /teachers/{teacherId} {
      allow read, write: if true;
    }
    match /leads/{leadId} {
      allow read, write: if true;
    }
    match /placementTests/{testId} {
      allow read, write: if true;
    }
    match /trialStudents/{trialId} {
      allow read, write: if true;
    }
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }
    match /transactions/{txId} {
      allow read, write: if true;
    }
    match /contactNotes/{noteId} {
      allow read, write: if true;
    }
    match /milestoneEvaluations/{evaluationId} {
      allow read, write: if true;
    }
    match /exams/{examId} {
      allow read, write: if true;
    }
    match /courses/{courseId} {
      allow read, write: if true;
    }
    match /kpis/{kpiId} {
      allow read, write: if true;
    }
    match /inventory/{itemId} {
      allow read, write: if true;
    }
    match /class_spreadsheets/{sheetId} {
      allow read, write: if true;
    }
    match /vocab_tests/{vocabTestId} {
      allow read, write: if true;
    }
    match /vocab_reviews/{vocabReviewId} {
      allow read, write: if true;
    }
  }
}
